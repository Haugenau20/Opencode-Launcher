# Copy to .env (start.sh does this for you on first run) and fill the blanks.
# .env is gitignored.
#
# IMPORTANT: keep comments on their OWN lines, never inline after a value.

# === Required: LLM ===========================================================
LLM_API_BASE=https://llm.internal.example/v1
# bearer token, per developer
LLM_API_KEY=

# === Required: Bitbucket =====================================================
# your Bitbucket username
BITBUCKET_USER=
# personal access token
BITBUCKET_PAT=

# === Git identity (for commits made inside the container) ====================
GIT_USER_NAME=
GIT_USER_EMAIL=

# === UID/GID (fix Linux bind-mount permissions) =============================
# start.sh auto-fills these from `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# === Safety switches =========================================================
# 1 enables git push/fetch/pull/clone
ALLOW_REMOTE_GIT=0
# 0 swaps session state for tmpfs
ENABLE_SESSION_LOGS=1

# === Optional ===============================================================
OPENCODE_SERVER_PASSWORD=

# === Image source ===========================================================
# REQUIRED: set this to your real Artifactory path before first run.
# Images pulled are <IMAGE_REGISTRY>:prod and <IMAGE_REGISTRY>-squid:prod.
IMAGE_REGISTRY=CHANGEME.artifactory.example/opencode-workplace
# Tag for the oc-publish socat sidecar's squid image. The prod overlay pins
# opencode and squid to :prod directly, but oc-publish is not in the overlay,
# so it reads this. Leave at prod.
IMAGE_TAG=prod
