# Copy to .env (start.sh does this for you on first run) and fill the blanks.
# .env is gitignored.
#
# IMPORTANT: keep comments on their OWN lines, never inline after a value.

# === Required: LLM ===========================================================
LLM_API_BASE=https://llm.internal.example/v1
# bearer token, per developer
LLM_API_KEY=

# === Optional: Bitbucket =====================================================
# Only needed if you want the agent to authenticate to Bitbucket. Leave blank
# to skip (start.sh lets you press Enter past these on first run).
# The REST API authenticates the PAT as a Bearer token (Bitbucket Data Center
# HTTP access token), so the MCP needs only BITBUCKET_BASE_URL + BITBUCKET_PAT —
# no username.
# REST API base URL, no trailing slash. Prefer the canonical HTTPS endpoint your
# server redirects to (e.g. https://bitbucket.internal.example:8443). The
# plain-HTTP connector (e.g. http://bitbucket.internal.example:7990) also serves
# the REST API, but a repo cloned from it can trigger a git auth-redirect prompt
# (see BITBUCKET_LEGACY_URL below). NOTE: https:// only works on the actual TLS
# port; pointing it at the plain-HTTP connector port gives a TLS "wrong version
# number" error.
BITBUCKET_BASE_URL=
# your Bitbucket username. OPTIONAL: not used by the REST API (Bearer), only by
# the git credential helper for git-over-HTTPS clone/push. Set it if you clone
# Bitbucket over HTTPS; leave blank for SSH remotes or REST-only use.
BITBUCKET_USER=
# personal access token (Bearer for the REST API; also the git password over HTTPS)
BITBUCKET_PAT=
# OPTIONAL: a legacy Bitbucket URL that redirects to BITBUCKET_BASE_URL (e.g. the
# plain-HTTP connector http://bitbucket.internal.example:7990). When set, the
# container adds a git url.insteadOf rewrite so any repo remote still pointing
# here is transparently upgraded to BITBUCKET_BASE_URL before git connects — no
# redirect, no "Username for 'https://…'" prompt. Leave blank if you have none.
BITBUCKET_LEGACY_URL=

# === Optional: Jira ==========================================================
# Only needed if you want the agent to reach Jira (REST API only). Leave blank
# to skip (Enter past these on first run).
# REST API base URL, no trailing slash.
JIRA_BASE_URL=
# personal access token, sent as a Bearer token — no username needed.
JIRA_PAT=

# === Optional: GitLab ========================================================
# Only needed if you want the agent to reach GitLab (git transport + REST API).
# Leave blank to skip (Enter past these on first run).
# Base URL over HTTPS, no trailing slash. REQUIRED — the GitLab MCP will not
# start without it.
GITLAB_BASE_URL=
# your GitLab username (used for git Basic auth)
GITLAB_USER=
# personal access token — one PAT covers both git and the REST API (sent via
# the PRIVATE-TOKEN header).
GITLAB_PAT=

# === JFrog Artifactory (REST API only) =======================================
# Optional. JFrog is an artifact repository, not a git remote, so this is
# API-only — like Jira, not Bitbucket/GitLab. The access token is presented as
# a Bearer token, so no username is needed. The JFrog MCP auto-enables only when
# both values below are set (and DISABLE_JFROG_MCP is not 1); leave either blank
# to keep it off.
#
# JFROG_BASE_URL is the JFrog platform base (the MCP appends /artifactory/api).
# The internal instance is served over HTTPS — TLS is validated via the corp CA
# baked into ca/. No trailing slash. If your image registry (IMAGE_REGISTRY
# below) lives on the same host, point this there too.
JFROG_BASE_URL=https://jfrog.internal.example
# JFrog access token (Bearer); generate one under Identity & Access
JFROG_PAT=

# === Confluence (REST API only) ==============================================
# Optional. API-only — like Jira, not Bitbucket/GitLab. Confluence Data Center
# authenticates the PAT as a Bearer token, so no username is needed. The
# Confluence MCP auto-enables only when both values below are set (and
# DISABLE_CONFLUENCE_MCP is not 1); leave either blank to keep it off.
#
# CONFLUENCE_BASE_URL is the site base, no trailing slash (the MCP appends
# /rest/api). Confluence's default connector is HTTP on port 8090, so INCLUDE
# the port — that port is opened in squid.conf. If your instance is served over
# standard HTTPS instead, use https://confluence.internal.example with no port.
CONFLUENCE_BASE_URL=http://confluence.internal.example:8090
# Confluence personal access token (Bearer); create one under your profile
CONFLUENCE_PAT=

# === M-Files (REST API only) =================================================
# Optional. API-only — like Jira/JFrog/Confluence, not Bitbucket/GitLab. M-Files
# does NOT use Authorization/Bearer or Basic: the token is presented via a custom
# X-Authentication header, so no username is needed. The M-Files MCP auto-enables
# only when both values below are set (and DISABLE_MFILES_MCP is not 1); leave
# either blank to keep it off.
#
# MFILES_BASE_URL is the site base over HTTPS, no trailing slash (the MCP appends
# /REST). TLS is validated via the corp CA baked into the image.
MFILES_BASE_URL=https://mfiles.internal.example
# M-Files authentication token, sent as the X-Authentication header value.
# Unlike the other services you MINT this yourself from your vault credentials
# — the setup wizard offers to do it for you right at this prompt (or run
# `./start.sh --mfiles-token` any time to mint/rotate one on its own). It asks
# for the vault URL, username, domain, vault GUID and password, and writes the
# result straight into this file — no copy-paste. See "M-Files authentication
# token" in docs/CUSTOMIZING.md for how to find the vault GUID and the manual
# curl fallback.
MFILES_PAT=

# === Optional: Git identity (for commits made inside the container) ==========
# Leave blank to skip. If unset, commits made in the container fall back to
# whatever git defaults are available there.
GIT_USER_NAME=
GIT_USER_EMAIL=

# === UID/GID (fix Linux bind-mount permissions) =============================
# start.sh auto-fills these from `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# === Safety switches =========================================================
# All off/empty by default — that's today's behaviour. Each takes effect on
# restart (re-run ./start.sh).

# 1 enables git push/fetch/pull/clone.
ALLOW_REMOTE_GIT=0
# OPTIONAL second gate, applied only when ALLOW_REMOTE_GIT=1: restrict WHERE
# remote git may go. Whitespace- or comma-separated `host/path` prefixes,
# matched on a path-segment boundary, so `.../sandbox/` admits
# `.../sandbox/foo` but not `.../sandbox-evil`. Empty = no restriction.
#   GIT_REMOTE_ALLOWLIST=gitlab.internal.example/sandbox/
GIT_REMOTE_ALLOWLIST=

# 1 lets the Confluence MCP create and edit pages instead of only reading
# them. Only the exact value 1 enables writes. Deleting pages is never
# possible, at 0 or 1.
ALLOW_CONFLUENCE_WRITE=0

# 1 lets the GitLab MCP open merge requests, comment, and create issues,
# instead of only reading. Only the exact value 1 enables writes. Even at 1
# there is deliberately no tool to set labels, close an issue, or merge an
# MR — if something else (a workflow queue, an orchestrator) tracks state
# via labels, that keeps the agent from marking its own work done.
ALLOW_GITLAB_WRITE=0
# OPTIONAL narrowing, applied only when ALLOW_GITLAB_WRITE=1: restrict writes
# to these projects. Whitespace- or comma-separated paths or numeric ids,
# same segment-boundary rule as GIT_REMOTE_ALLOWLIST above — `mygroup`
# admits `mygroup/service`, not `mygroup-evil`. Empty = no restriction.
#   GITLAB_WRITE_PROJECTS=mygroup/my-sandbox-project
GITLAB_WRITE_PROJECTS=
# The label namespace the GitLab MCP is never allowed to set, even at
# ALLOW_GITLAB_WRITE=1. It exists because an orchestrator can own labels under
# a prefix as ITS OWN state — an agent able to relabel its own issue could mark
# its own work reviewed, or queue itself more work forever.
#
# NOT an off-by-default switch, unlike everything else in this section: blanking
# it does not remove the protection, it selects the built-in default, which is
# `symphony`. Set it to protect a different namespace; there is no value that
# protects none.
GITLAB_QUEUE_LABEL_PREFIX=symphony

# GIT_REMOTE_ALLOWLIST and GITLAB_WRITE_PROJECTS are defence in depth, NOT a
# security boundary: an agent with a shell can call git and the GitLab API
# directly, bypassing both. They turn a mistake — a stale remote, a
# hallucinated project — into a clear local error, not a confusing 403. The
# real boundary is what the token itself is scoped and permissioned to do.

# 1 force-disables a service's MCP even when its credentials are present in
# .env (the image auto-enables each MCP when its full var set is supplied).
DISABLE_BITBUCKET_MCP=0
DISABLE_JIRA_MCP=0
DISABLE_GITLAB_MCP=0
DISABLE_JFROG_MCP=0
DISABLE_CONFLUENCE_MCP=0
DISABLE_MFILES_MCP=0

# === Optional: personal (you-only) agents/skills/commands ===================
# Bind-mount a host dir as your personal config layer so you can edit your own
# agents/skills/commands from the host without entering the container. Shared
# across all repos you launch. Leave empty to use a per-project named volume
# instead (still a working user layer, just not host-editable).
# Example: ./user-layer
USER_LAYER_PATH=

# === Optional: baked-in plugins (opt-in, OFF by default) =====================
# The image ships four plugins (superpowers, dcp, opencode-workspace,
# opencode-pty), all DISABLED by default. List the ones you want here (space-
# OR comma-separated) and they get symlinked in on boot; they load offline
# from the image (no network). Empty = no plugins. A restart applies changes
# (re-running start.sh IS the restart).
# opencode-pty adds a web viewer, reachable at http://localhost:1<port> (the
# base OPENCODE_PORT with a literal '1' prepended) once started in the TUI
# with /pty-open-background-spy — start.sh/--status print the exact URL.
# What each plugin is + upstream links: see the README "Plugins" section. The
# live set and versions: the /plugins command inside the TUI.
# Example: ENABLED_PLUGINS=superpowers dcp
ENABLED_PLUGINS=

# === Image source ===========================================================
# REQUIRED: set this to your real Artifactory path before first run.
# Images pulled are <IMAGE_REGISTRY>:${IMAGE_TAG} and
# <IMAGE_REGISTRY>-squid:${IMAGE_TAG}.
IMAGE_REGISTRY=CHANGEME.artifactory.example/opencode-workplace
# Image tag pulled for all three services (opencode, squid, oc-publish).
# Defaults to 'latest' (the moving tag that always points at the newest upload).
# Pin a specific version instead by setting an explicit number, e.g. 0.0.2.
# Pinning matters now that plugin behavior (above) is baked into the image: a
# fixed tag keeps the available plugins and their versions reproducible.
IMAGE_TAG=latest
