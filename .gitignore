# Local secrets / identity — never commit.
.env

# Per-project generated env files.
.envs/

# Local allowlist drop-ins (the dir is tracked via .gitkeep; its contents are not).
extra-allowlist.d/*.conf

# Personal user-layer config (host-editable agents/skills/commands).
user-layer/

# Personal system-package list (baked into a local image at build time).
