#!/usr/bin/env bash
#
# Fake `docker` for the test suite. Records the full argv of every call (one
# line per invocation) to $FAKE_DOCKER_LOG and returns a controllable exit code
# per subcommand, so tests can drive start.sh down specific branches without a
# real Docker daemon or registry.
#
# Knobs (all optional, read from the environment):
#   FAKE_DOCKER_LOG               file to append argv to (default: /dev/null)
#   FAKE_DOCKER_INFO_RC           rc for `docker info`                (default 0)
#   FAKE_DOCKER_INFO_STDERR       stderr emitted by `docker info`     (default "")
#   FAKE_DOCKER_COMPOSE_VERSION_RC rc for `docker compose version`    (default 0)
#   FAKE_DOCKER_COMPOSE_RC        rc for `docker compose <pull|up|…>` (default 0)
#   FAKE_DOCKER_MANIFEST_RC       rc for `docker manifest inspect`    (default 0)
#   FAKE_DOCKER_MANIFEST_STDERR   stderr emitted by manifest inspect  (default "")
#   FAKE_DOCKER_EXEC_RC           rc for `docker exec` (TUI attach)   (default 0)
#   FAKE_DOCKER_VERSION_OUTPUT    stdout for `docker --version`       (default "Docker version 99.0.0-fake")

: "${FAKE_DOCKER_LOG:=/dev/null}"
printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG"

sub="${1:-}"
case "$sub" in
  info)
    [ -n "${FAKE_DOCKER_INFO_STDERR:-}" ] && printf '%s\n' "$FAKE_DOCKER_INFO_STDERR" >&2
    exit "${FAKE_DOCKER_INFO_RC:-0}"
    ;;
  compose)
    if [ "${2:-}" = version ]; then
      echo "Docker Compose version v2.99.0-fake"
      exit "${FAKE_DOCKER_COMPOSE_VERSION_RC:-0}"
    fi
    # pull / up -d / anything else
    exit "${FAKE_DOCKER_COMPOSE_RC:-0}"
    ;;
  manifest)
    [ -n "${FAKE_DOCKER_MANIFEST_STDERR:-}" ] && printf '%s\n' "$FAKE_DOCKER_MANIFEST_STDERR" >&2
    exit "${FAKE_DOCKER_MANIFEST_RC:-0}"
    ;;
  exec)
    exit "${FAKE_DOCKER_EXEC_RC:-0}"
    ;;
  --version)
    printf '%s\n' "${FAKE_DOCKER_VERSION_OUTPUT:-Docker version 99.0.0-fake}"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
